{
  // Mozari · TOURS (público, solo lectura)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mozari-tours",
  "main": "../tours.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "tours.mozari.app", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "../../estudio",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Tope de cálculo por petición (plan Paid): el visor solo sirve archivos, 500 ms sobra
  "limits": { "cpu_ms": 500 },
  // Registro de visitas y errores: 1 de cada 10 peticiones (son muchas piezas de esfera y así no cuesta)
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "r2_buckets": [{ "binding": "R2", "bucket_name": "mozari" }]
}
