{
  // Mozari · TOURS (público, solo lectura)
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mozari-tours",
  "main": "tours.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "R2", "bucket_name": "mozari" }]
}
