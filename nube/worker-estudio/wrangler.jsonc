{
  // Mozari · la plataforma: escaparate, cuentas con Google y estudio.
  // Secretos (Cloudflare → este Worker → Settings → Variables and Secrets):
  //   GOOGLE_CLIENT_SECRET
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mozari-estudio",
  "main": "../estudio.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "mozari.app", "custom_domain": true }, { "pattern": "www.mozari.app", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "../../estudio",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/t/*", "/entrar", "/auth/*", "/salir", "/dispositivos", "/dispositivos/*", "/webhooks/*", "/planes", "/precios", "/pro", "/desarrollos", "/v/*", "/baja", "/correo/novedad/*", "/galeria.json", "/ventas.csv"]
  },
  "version_metadata": { "binding": "VERSION" },
  "triggers": { "crons": ["17 * * * *"] },
  // Tope de cálculo por petición (plan Paid): si algo se cicla, se corta en 2 s y no genera cobros grandes
  "limits": { "cpu_ms": 2000 },
  // Registro de errores: para ver qué falló y a quién (Workers Logs)
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [{ "binding": "R2", "bucket_name": "mozari" }],
  // Correo de avisos (Email Routing de mozari.app): cada reporte de error le llega al dueño
  // ENVIOS (Email Service): correos a los usuarios desde hola@mozari.app (bienvenida y novedades).
  // El plan incluye 3,000 al mes; Mozari se detiene en 2,800 (ver nube/correos.js).
  "send_email": [{ "name": "CORREO", "destination_address": "amarpreciado93@gmail.com" }, { "name": "ENVIOS" }],
  "vars": {
    // Dueño de Mozari: se queda con los tours creados antes de las cuentas
    "DOMINIO": "mozari.app",
    "ADMIN": "amarpreciado93@gmail.com",
    // ID público de la llave de Google (proyecto "Mozari" en Google Cloud). El secreto va aparte.
    "GOOGLE_CLIENT_ID": "714496356293-4du5n8fsqmr3hp8u7942en9dbucaoduf.apps.googleusercontent.com"
  }
}
